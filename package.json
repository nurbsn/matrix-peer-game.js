{
  "name": "nomnipeer",
  "version": "1.0.0",
  "description": "Omni-channel serverless P2P game networking library for WebRTC with NOSTR, MQTT, Firebase, Matrix, and Direct P2P matchmaking",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/nomnipeer.js",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "nomnipeer",
    "multiplayer",
    "webrtc",
    "peerjs",
    "nostr",
    "mqtt",
    "firebase",
    "matrix",
    "matrix-org",
    "gamedev",
    "serverless",
    "p2p",
    "fps",
    "rts",
    "lockstep"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "peerjs": "^1.5.4"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
